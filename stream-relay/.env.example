# Copy to .env and edit. Works on networks where you can't reserve IP addresses.

# Rokus to auto-launch on, "Name=SERIAL" comma separated. Serial numbers are stable, so a
# Roku that gets a new IP from DHCP is found again by scanning the subnet. IPs also work.
# Find serials: Settings > System > About, or http://<roku-ip>:8060/query/device-info.
# "auto" launches on every Roku found -- only sensible on a network nobody else uses.
ROKU_DEVICES=Living Room=X000000AAAAA,Bedroom=X000000BBBBB

# Leave unset: the relay tells each Roku its own LAN address on every launch, so a
# changed homelab IP fixes itself. Set it only if that detection picks the wrong address.
# PUBLIC_BASE_URL=http://192.168.1.10:8080

RELAY_PORT=8080

# Optional shared secret for cast/stop/refresh (the TV's status polling stays open).
# RELAY_TOKEN=change-me

# Sideloaded dev channels always have the app id "dev".
# ROKU_APP_ID=dev
# ROKU_POWER_ON=1          # wake Roku TVs before launching
# ROKU_SCAN_SUBNET=192.168.2.0/24   # default: this machine's /24
# AUTO_LAUNCH=1            # switch the TV to the channel on every cast

# yt-dlp
# YTDLP_AUTO_UPDATE=1
# YTDLP_FORMAT=best[protocol^=m3u8]/bv*[vcodec^=avc1][height<=1080]+ba[acodec^=mp4a]/b[ext=mp4][vcodec^=avc1]/bv*[height<=1080]+ba/b
# PREFER_HLS_MASTER=1      # keep adaptive bitrate when yt-dlp finds an HLS master

# Upstream behaviour
# UPSTREAM_TIMEOUT=15
# UPSTREAM_RETRIES=4
# REFRESH_COOLDOWN=15      # min seconds between re-resolves
# SEGMENT_CACHE_MB=192
# PREFETCH_SEGMENTS=2
# VERIFY_TLS=1

# Headless-browser fallback: last resort for JS-assembled streams (players inside
# cross-origin iframes, streams built by script after page load). Adds ~5-10 s only
# when the fast paths fail. The Docker image ships Chromium; bare-metal also needs
# `playwright install chromium`. Off: BROWSER_SNIFF=0
# BROWSER_SNIFF=1
# BROWSER_TIMEOUT=25       # total seconds the browser sniff may take

# FFmpeg (DASH, MKV/WebM, separate audio+video, RTMP...)
# PROGRESSIVE_MODE=direct  # "hls" to remux plain MP4 links too
# FFMPEG_VIDEO_ENCODER=libx264   # only used when the codec isn't Roku-friendly
# FFMPEG_PRESET=veryfast
# HLS_TIME=4

# RESUME_ON_START=1        # re-open the last stream after a restart
# LOG_LEVEL=INFO
